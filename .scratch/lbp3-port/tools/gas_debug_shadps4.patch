+// [DEBUG-gas] LBP3_CS_READBACK=1 (or =<cs hash>,<cs hash>...): copy the buffers those compute
+// shaders write (up to 4 MB each) back to guest memory at the next fence.
+static std::vector<std::pair<VAddr, u64>> lbp3_cs_written;
+static u64 lbp3_cs_readback_bytes = 0, lbp3_cs_readback_fences = 0;
+void Rasterizer::Lbp3QueueCsReadback(const Shader::Info& cs) {
+    static const char* spec = std::getenv("LBP3_CS_READBACK");
+    if (!spec) {
+        return;
+    }
+    if (std::strcmp(spec, "1") != 0) {
+        char hash[20];
+        std::snprintf(hash, sizeof(hash), "%016llx", (unsigned long long)cs.pgm_hash);
+        if (!std::strstr(spec, hash)) {
+            return;
+        }
+    }
+    for (const auto& desc : cs.buffers) {
+        if (desc.IsSpecial() || !desc.is_written) {
+            continue;
+        }
+        const auto sharp = desc.GetSharp(cs);
+        if (sharp.base_address && sharp.GetSize() <= 4_MB) {
+            lbp3_cs_written.emplace_back(sharp.base_address, sharp.GetSize());
+        }
+    }
+}
+
+void Rasterizer::Lbp3ProcessCsReadback() {
+    if (lbp3_cs_written.empty()) {
+        return;
+    }
+    if (g_lbp3TraceDraws) {
+        std::fprintf(stderr, "[DEBUG-gas] fence after #%u: %zu readbacks pending\n", g_lbp3TraceIndex,
+                     lbp3_cs_written.size());
+    }
+    for (const auto& [addr, size] : lbp3_cs_written) {
+        buffer_cache.ReadMemory(addr, size, false, true);
+        lbp3_cs_readback_bytes += size;
+    }
+    lbp3_cs_written.clear();
+    if ((++lbp3_cs_readback_fences % 300) == 1) {
+        std::fprintf(stderr, "[DEBUG-gas] cs readback: %llu fences, %llu MB requested\n",
+                     (unsigned long long)lbp3_cs_readback_fences,
+                     (unsigned long long)(lbp3_cs_readback_bytes >> 20));
+    }
+}
