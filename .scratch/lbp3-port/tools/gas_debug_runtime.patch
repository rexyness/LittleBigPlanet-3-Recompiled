+// [DEBUG-gas] the read probe (debugger.h ArmReadProbe)
+std::mutex g_probeMutex;
+std::unordered_map<uint64_t, DWORD> g_probePages;  // page -> the protection to give back
+std::vector<Module*> g_probeModules;
+std::atomic<int> g_probeLogged{0};
+
+std::string ProbeWhere(uint64_t a) {
+    char buf[96];
+    for (const Module* m : g_probeModules)
+        if (m->Contains(reinterpret_cast<const void*>(a))) {
+            std::snprintf(buf, sizeof(buf), "%s+0x%llx", m->fileName.c_str(),
+                          static_cast<unsigned long long>(a - reinterpret_cast<uint64_t>(m->base)));
+            return buf;
+        }
+    std::snprintf(buf, sizeof(buf), "%llx", static_cast<unsigned long long>(a));
+    return buf;
+}
+
+LONG CALLBACK ReadProbeHandler(EXCEPTION_POINTERS* ep) {
+    if (ep->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION) return EXCEPTION_CONTINUE_SEARCH;
+    const uint64_t addr = ep->ExceptionRecord->ExceptionInformation[1];
+    const uint64_t page = addr & ~0xfffull;
+    {
+        std::lock_guard lock(g_probeMutex);
+        auto it = g_probePages.find(page);
+        if (it == g_probePages.end()) return EXCEPTION_CONTINUE_SEARCH;
+        DWORD old;
+        VirtualProtect(reinterpret_cast<void*>(page), 0x1000, it->second, &old);
+        g_probePages.erase(it);
+    }
+    if (g_probeLogged++ < 600) {
+        const ULONG_PTR kind = ep->ExceptionRecord->ExceptionInformation[0];
+        std::string thread = "?";
+        PWSTR desc = nullptr;
+        if (SUCCEEDED(GetThreadDescription(GetCurrentThread(), &desc)) && desc) {
+            char narrow[64] = {};
+            WideCharToMultiByte(CP_UTF8, 0, desc, -1, narrow, sizeof(narrow) - 1, nullptr, nullptr);
+            thread = narrow;
+            LocalFree(desc);
+        }
+        std::fprintf(stderr, "[DEBUG-gas] read probe: %s %llx by %s (thread %lu %s)\n",
+                     kind == 0 ? "read" : kind == 1 ? "write" : "exec", static_cast<unsigned long long>(addr),
+                     ProbeWhere(ep->ContextRecord->Rip).c_str(), GetCurrentThreadId(), thread.c_str());
+    }
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
 }  // namespace
 
+void ArmReadProbe(uint64_t addr, uint64_t size) {
+    static std::once_flag once;
+    std::call_once(once, [] { AddVectoredExceptionHandler(1, ReadProbeHandler); });
+    size_t armed = 0;
+    for (uint64_t page = addr & ~0xfffull; page < addr + size; page += 0x1000) {
+        std::lock_guard lock(g_probeMutex);  // armed and recorded together, so no fault can miss it
+        DWORD old;
+        if (g_probePages.contains(page) ||
+            !VirtualProtect(reinterpret_cast<void*>(page), 0x1000, PAGE_NOACCESS, &old))
+            continue;
+        g_probePages.emplace(page, old);
+        ++armed;
+    }
+    std::fprintf(stderr, "[DEBUG-gas] read probe armed on %zu pages at %llx+%llx\n", armed,
+                 static_cast<unsigned long long>(addr), static_cast<unsigned long long>(size));
+}
+
