+// [DEBUG-gas] ReadMemory without the 512 KB window: just the range (GPU thread, waits).
+void BufferCache::DownloadRange(VAddr device_addr, u64 size) {
+    const u32 first_block = device_addr >> block_shift;
+    const u32 last_block = (device_addr + size - 1) >> block_shift;
+    DownloadMemory(GetArena(first_block, last_block), device_addr, size);
+}
+
+// [DEBUG-gas] copies what the GPU wrote in the range to guest memory without waiting: it lands
+// once the GPU has run this far. The GPU copy stays the one the GPU uses.
+bool BufferCache::MirrorToGuestAsync(VAddr device_addr, u64 size) {
+    const u32 first_block = device_addr >> block_shift;
+    const u32 last_block = (device_addr + size - 1) >> block_shift;
+    const Buffer* arena = GetArena(first_block, last_block);
+    const VAddr arena_base = arena->cpu_addr;
+    boost::container::small_vector<vk::BufferCopy, 4> copies;
+    u64 total_size_bytes = 0;
+    gpu_modified_ranges.ForEachInRange(device_addr, size, [&](VAddr start, VAddr end) {
+        copies.push_back(vk::BufferCopy{
+            .srcOffset = start - arena_base,
+            .dstOffset = total_size_bytes,
+            .size = end - start,
+        });
+        total_size_bytes += Common::AlignUp(end - start, 64);
+    });
+    if (total_size_bytes == 0) {
+        return false;
+    }
+    const auto staging =
+        staging_pool.Request(total_size_bytes, VideoCore::MemoryType::HostCached, 64, true);
+    for (auto& copy : copies) {
+        copy.dstOffset += staging.offset;
+    }
+    runtime.CopyBuffer(arena, staging.buffer, copies);
+    scheduler.DeferPriorityOperation([this, arena_base, copies, staging] {
+        staging.Invalidate();
+        for (const auto& copy : copies) {
+            memory->TryWriteBacking(std::bit_cast<u8*>(arena_base + copy.srcOffset),
+                                    staging.mapped + (copy.dstOffset - staging.offset), copy.size);
+        }
+        staging_pool.FreeDeferred(staging);
+    });
+    return true;
+}
