// LBP3Launcher's icon (our own artwork, make_icon.py) and version information.
#include <winver.h>

1 ICON "lbp3launcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LBP3 native port"
            VALUE "FileDescription", "LittleBigPlanet 3 Launcher (native port)"
            VALUE "FileVersion", "2.0"
            VALUE "InternalName", "LBP3Launcher"
            VALUE "LegalCopyright", "GPL-2.0-or-later"
            VALUE "OriginalFilename", "LBP3Launcher.exe"
            VALUE "ProductName", "LittleBigPlanet 3 Launcher"
            VALUE "ProductVersion", "2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
