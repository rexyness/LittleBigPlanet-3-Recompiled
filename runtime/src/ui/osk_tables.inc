// Key tables of the on-screen keyboard: the PS4 keyboard's pages as shadPS4 laid them out.
// Key tables from shadPS4's ime_kb_layout.cpp (src/core/libraries/ime), Copyright 2026 shadPS4
// Emulator Project, GPL-2.0-or-later. Changes here: our own KeySpec/Action/Glyph types, and the
// hotkey hints as tokens the drawer turns into button shapes ("TRI", "SQR", "L2+TRI").
// Included once, by ui/osk_model.cpp, inside namespace ui::osk.
//
// Rows 0-3 (0-4 on the 7-row Specials pages) are typing keys; the last two rows are the
// function rows. Keyboard (language switch), Menu and Settings (motion control) keys exist
// on a PS4 but do nothing in this port, so the model treats them as gaps.

#define KEY(r, c, label, action) KeySpec{r, c, 1, 1, label, nullptr, Action::action, Glyph::None}
#define KEYHOT(r, c, label, hotkey, action) KeySpec{r, c, 1, 1, label, hotkey, Action::action, Glyph::None}
#define KEYSPAN(r, c, cs, rs, label, action) KeySpec{r, c, cs, rs, label, nullptr, Action::action, Glyph::None}
#define KEYSPANHOT(r, c, cs, rs, label, hotkey, action) KeySpec{r, c, cs, rs, label, hotkey, Action::action, Glyph::None}
#define KEYGLYPH(r, c, glyph, action) KeySpec{r, c, 1, 1, nullptr, nullptr, Action::action, Glyph::glyph}
#define KEYHOTGLYPH(r, c, hotkey, glyph, action) KeySpec{r, c, 1, 1, nullptr, hotkey, Action::action, Glyph::glyph}
#define KEYSPANGLYPH(r, c, cs, rs, glyph, action) KeySpec{r, c, cs, rs, nullptr, nullptr, Action::action, Glyph::glyph}
#define KEYSPANHOTGLYPH(r, c, cs, rs, hotkey, glyph, action) KeySpec{r, c, cs, rs, nullptr, hotkey, Action::action, Glyph::glyph}

